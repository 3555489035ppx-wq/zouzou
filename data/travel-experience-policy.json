  "planB": [
    {"id":"rain","trigger":"下雨","action":"先缩短可选户外停留，优先同片区室内文化体验或休息；确认开放和预约后再替换。"},
    {"id":"heat","trigger":"太热","action":"把可选户外步行移到较凉爽的早晚，中午安排用餐、室内体验或休息。"},
