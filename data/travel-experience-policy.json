  "scenarios": [
    {"id":"early_riser","terms":["早起","早出门"],"advice":"在已确认开放时间内优先上午体验，前一晚适当收早。"},
    {"id":"late_riser","terms":["晚起","睡到自然醒","不早起"],"advice":"上午只留弹性安排，主要体验集中在午后，减少当天项目总量。"},
    {"id":"couple","terms":["情侣","约会","恋人"],"advice":"每天留一段可以慢慢走、喝东西和聊天的时间，夜游作为自选项。"},
    {"id":"friends","terms":["朋友","闺蜜","兄弟"],"advice":"先选全员都想去的一项核心体验，其余按共同兴趣安排，预留集合时间。"},
    {"id":"solo","terms":["独自","一个人","独行"],"advice":"减少为凑人数设计的餐饮与活动，夜间活动结束前确认回程方式。"},
    {"id":"family","terms":["亲子","带娃","孩子","儿童"],"advice":"上午集中主要体验，午后留休息，不把多个大型场馆放在同一天。"},
    {"id":"parents","terms":["父母","老人","长辈"],"advice":"连续步行之间安排坐下休息，优先同片区体验；台阶与无障碍条件另行确认。"},
    {"id":"first","terms":["第一次","初次"],"advice":"先选城市最有代表性且符合兴趣的体验，每天一个清楚的主题。"},
    {"id":"repeat","terms":["二刷","再去","去过"],"advice":"降低已去过的热门点优先级，增加社区街区、专题展和本地生活体验。"},
    {"id":"student","terms":["学生","学生党"],"advice":"优先免费公共空间和地方小吃；学生优惠仅在核对适用条件后计入。"},
    {"id":"budget","terms":["低预算","省钱","穷游"],"advice":"减少重复付费项目和跨片区移动，先保留吃住与返程预算。"},
    {"id":"photo","terms":["拍照","摄影","出片"],"advice":"把同片区步行与拍照合并，光线随季节天气变化，不承诺固定机位无人。"},
    {"id":"food","terms":["美食","小吃","逛吃"],"advice":"一餐主打地方正餐，另一餐换口味，小吃少量分享，避免连续重油重辣。"},
    {"id":"museum","terms":["博物馆","展览","文博"],"advice":"一日优先一个重点场馆，围绕感兴趣的展厅留时间，出馆后安排轻活动。"},
    {"id":"walk","terms":["City Walk","citywalk","漫步"],"advice":"围绕一个连续片区步行，穿插咖啡或休息，可从任一节点提前结束。"},
    {"id":"weekend","terms":["周末"],"advice":"到达当天不追赶大型项目，第二天先完成主要体验再留返程时间。"},
    {"id":"birthday","terms":["生日"],"advice":"庆祝用餐作为当天锚点，前后少排项目；布置与服务须向店家确认。"},
    {"id":"anniversary","terms":["纪念日"],"advice":"集中安排一项有纪念感的体验，留出正餐和自由相处时间。"},
    {"id":"dinner","terms":["聚餐"],"advice":"先统一预算和全员忌口，再选聚餐片区，附近活动作为自选补充。"},
    {"id":"nightlife","terms":["夜生活","夜游","夜景"],"advice":"晚间体验和白天游览错开强度，保留回程安排；晚睡后次日适当晚起。"}
