{
  "name": "zouzou-local-prototype",
  "private": true,
  "packageManager": "pnpm@11.24.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:release": "tsc -b && node scripts/build-release.mjs",
    "dev": "vite --host 0.0.0.0",
    "server": "tsx server/index.ts",
    "guides:collect": "tsx scripts/collect-xhs-guides.ts",
    "guides:review:first20": "tsx scripts/build-reviewed-three-platform-guides.ts",
    "guides:evaluate:first20": "tsx scripts/evaluate-reviewed-three-platform-guides.ts",
    "guides:enrich:bilibili": "tsx scripts/enrich-bilibili-held-guides.ts",
