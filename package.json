    "guides:certify:first20": "tsx scripts/certify-first-20-city-guides.ts",
    "images:sync": "tsx scripts/sync-city-images.ts",
    "journey-images:generate": "tsx scripts/generate-journey-images.ts",
    "journey-images:regenerate": "tsx scripts/generate-journey-images.ts",
    "journey-images:acquire": "tsx scripts/acquire-journey-images.ts",
