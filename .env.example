# 前端本地地图：只创建 Web 端（JS API）的 Key，并为部署域名设置白名单。
VITE_AMAP_KEY=
VITE_AMAP_SECURITY_KEY=
# 默认使用 MapLibre + 可配置的真实步行路线服务；仅在域名白名单和授权完成后填 amap。
VITE_MAP_PROVIDER=maplibre
# 作品集演示可开启免 Key 的实时天气；失败时会明确显示天气服务不可用。
VITE_LIVE_WEATHER=1
# 可选的公共步行路线服务；留空使用默认的 OpenStreetMap foot router。
# 上线前请替换为已备案、可监控且符合配额/隐私要求的路线服务。
VITE_WALKING_ROUTE_URL=

# 第一步：启用服务端文本理解。推荐在中国大陆使用 DeepSeek。
VITE_REMOTE_AI=0
VITE_API_BASE_URL=

# 服务端变量：不要加 VITE_ 前缀，也不要提交真实值。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# 可选的 OpenAI 备用供应商。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# 第二阶段：截图理解。Key 只放服务端，绝不能加 VITE_ 前缀。
# 留空时按百炼 -> 智谱 -> 豆包 -> DeepSeek 自动选择；也可以显式指定。
VISION_ENABLED=1
VISION_PROVIDER=
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=
VISION_PROTOCOL=chat
VISION_TIMEOUT_MS=25000

# 推荐的国内低价视觉模型（二选一即可）。
DASHSCOPE_API_KEY=
DASHSCOPE_VISION_MODEL=qwen3-vl-flash
DASHSCOPE_BASE_URL=
ZHIPU_API_KEY=
ZHIPU_VISION_MODEL=glm-4.6v-flash
ZHIPU_BASE_URL=

# 豆包需要在方舟控制台创建视觉 Endpoint，填 Endpoint ID。
DOUBAO_API_KEY=
DOUBAO_VISION_MODEL=
DOUBAO_BASE_URL=

# 已有 DeepSeek Key 时可启用官方视觉实验模型；不稳定时会自动回退到文字理解。
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
PORT=8787
# 生产填写明确的前端来源，逗号分隔；留空仅适合本地开发。
CORS_ORIGIN=http://localhost:4173
