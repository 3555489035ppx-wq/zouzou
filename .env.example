# 作品集演示可开启免 Key 的实时天气；失败时会明确显示天气服务不可用。
VITE_LIVE_WEATHER=1

# 显式本地模式为0；生产接入获准发布的云端服务后设为1。
VITE_REMOTE_AI=0
VITE_API_BASE_URL=

# 服务端变量：不要加 VITE_ 前缀，也不要提交真实值。
AI_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# 供应商可选项；不自动切换供应商，不代表已核验地区或账号可用性。
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# 第二阶段：截图理解。Key 只放服务端，绝不能加 VITE_ 前缀。
# 留空时按百炼 -> 智谱 -> 豆包 -> DeepSeek 自动选择；也可以显式指定。
VISION_ENABLED=1
VISION_PROVIDER=
VISION_MODEL=
VISION_API_KEY=
VISION_BASE_URL=
VISION_PROTOCOL=chat
VISION_TIMEOUT_MS=25000

# 推荐的国内低价视觉模型（二选一即可）。
DASHSCOPE_API_KEY=
DASHSCOPE_VISION_MODEL=qwen3-vl-flash
DASHSCOPE_BASE_URL=
ZHIPU_API_KEY=
ZHIPU_VISION_MODEL=glm-4.6v-flash
ZHIPU_BASE_URL=

# 豆包需要在方舟控制台创建视觉 Endpoint，填 Endpoint ID。
DOUBAO_API_KEY=
DOUBAO_VISION_MODEL=
DOUBAO_BASE_URL=

# 已有 DeepSeek Key 时可启用官方视觉实验模型；不稳定时会自动回退到文字理解。
DEEPSEEK_VISION_MODEL=deepseek-v4-flash-vision-exp
PORT=8787
# 生产填写明确的前端来源，逗号分隔；留空仅适合本地开发。
CORS_ORIGIN=http://localhost:4173

# 前端公开变量，不是密钥。正式构建采用已核验的项目域名。
VITE_PUBLIC_APP_ORIGIN=https://zouzou.ppx.wiki
# Pages 服务端公开配置；预览应使用隔离环境，不接生产数据库。
PUBLIC_APP_ORIGIN=https://zouzou.ppx.wiki
# 不可变的已许可知识发行号；不能填写 schema version 或文件时间代替。
KNOWLEDGE_VERSION=
# 生产发行采用docs/CONTENT-AUTHORIZATION.md中的用户许可声明。
# 新环境默认false，接入对应不可变发行版本后再开启。
KNOWLEDGE_RELEASE_APPROVED=false
# DB 是 Pages D1 binding，不是放在 .env 的连接字符串。
